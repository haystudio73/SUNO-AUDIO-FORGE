<Window x:Class="StemForge.LyricsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="{DynamicResource i18n.3193ED44B92509F7}" Width="1120" Height="800" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Window.Resources>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1565C0"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style x:Key="LyricText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{DynamicResource i18n.765812A73C0A93A5}" FontSize="24" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="SongTitle" Margin="0,6,0,12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{DynamicResource i18n.F9AAC60D130B5D7C}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,16"/></StackPanel>
  <WrapPanel x:Name="RecognitionOptions" Grid.Row="1" Margin="0,0,0,12">
   <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource i18n.5E2C614C23F02239}" Style="{StaticResource Caption}"/><ComboBox x:Name="ModelBox" Width="130" SelectedValuePath="Tag"><ComboBoxItem Content="tiny" Tag="tiny"/><ComboBoxItem Content="base" Tag="base"/><ComboBoxItem Content="small" Tag="small"/><ComboBoxItem Content="medium" Tag="medium"/><ComboBoxItem Content="turbo" Tag="turbo"/><ComboBoxItem Content="large-v3" Tag="large-v3"/></ComboBox></StackPanel>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource i18n.7DD0BFABEA7E8DAB}" Style="{StaticResource Caption}"/><ComboBox x:Name="LanguageBox" Width="230" DisplayMemberPath="Name" SelectedValuePath="Code"/></StackPanel>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource i18n.EB7069795683D310}" Style="{StaticResource Caption}"/><ComboBox x:Name="DeviceBox" Width="100" SelectedValuePath="Tag"><ComboBoxItem Content="{DynamicResource i18n.0286249762F7C943}" Tag="auto"/><ComboBoxItem Content="CPU" Tag="cpu"/><ComboBoxItem Content="CUDA" Tag="cuda"/></ComboBox></StackPanel>
   <Button x:Name="TranscribeButton" Content="{DynamicResource i18n.B061267694296637}" Click="Transcribe" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Style="{StaticResource IconLabelButton}" Tag="{StaticResource LyricsIcon}"/>
   <Button Content="{DynamicResource i18n.A6BC59B907C5F284}" Click="InstallWhisper" VerticalAlignment="Bottom" ToolTip="{DynamicResource i18n.6AB7421926BC4404}" Style="{StaticResource IconLabelButton}" Tag="{StaticResource DownloadIcon}"/>
   <Button x:Name="SunoTimingButton" Content="{DynamicResource i18n.916C8911F9E6B78B}" Click="FetchSunoTiming" VerticalAlignment="Bottom" Style="{StaticResource IconLabelButton}" Tag="{StaticResource LyricsIcon}"/>
   <TextBlock x:Name="SunoSource" Width="500" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0"/>
  </WrapPanel>
  <DockPanel Grid.Row="2" Margin="0,0,0,10"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{DynamicResource i18n.FFF001AF25E255EE}" Click="CancelJob" IsEnabled="False" Style="{StaticResource IconLabelButton}" Tag="{StaticResource CancelIcon}"/><TextBlock x:Name="Status" Text="{DynamicResource i18n.415BB6A75127D534}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></DockPanel>
  <DataGrid x:Name="LinesGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0" Background="{DynamicResource Surface}" RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource InputBackground}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" HorizontalGridLinesBrush="{DynamicResource Line}" VerticalGridLinesBrush="{DynamicResource Line}" GridLinesVisibility="Horizontal" CellEditEnding="Edited" BeginningEdit="BeginLyricsEdit">
   <DataGrid.Columns>
    <DataGridTextColumn Header="{DynamicResource i18n.B3CACC46A7DBA138}" Width="145" MinWidth="145" Binding="{Binding Start, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource LyricText}"/>
    <DataGridTextColumn Header="{DynamicResource i18n.35184912FA636159}" Width="145" MinWidth="145" Binding="{Binding End, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource LyricText}"/>
    <DataGridTextColumn Header="{DynamicResource i18n.B78C6EA7B9AAE4F2}" Width="*" MinWidth="260" Binding="{Binding Text, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource LyricText}"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0">
   <TextBlock Text="{DynamicResource i18n.5B2498E8C186B2C4}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
   <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ValueChanged="SeekChanged" AutomationProperties.Name="{DynamicResource i18n.EAB4C44DFF359B29}"/>
   <WrapPanel x:Name="ListenControls">
    <Button Style="{StaticResource TransportButton}" Content="{StaticResource PlayIcon}" Click="PlayAll" ToolTip="{DynamicResource i18n.5D5E16F2ED799036}" AutomationProperties.Name="{DynamicResource i18n.6A34F2379FE14455}"/>
    <Button Style="{StaticResource TransportButton}" Content="{StaticResource PauseIcon}" Click="Pause" ToolTip="{DynamicResource i18n.6763581534939FAA}" AutomationProperties.Name="{DynamicResource i18n.6763581534939FAA}"/>
    <Button Style="{StaticResource TransportButton}" Content="{StaticResource StopIcon}" Click="Stop" ToolTip="{DynamicResource i18n.11554138C0405AC3}" AutomationProperties.Name="{DynamicResource i18n.11554138C0405AC3}"/>
    <CheckBox x:Name="Repeat" Style="{StaticResource RepeatButton}"/>
    <Button Style="{StaticResource TransportButton}" Content="{StaticResource PlayIcon}" Click="PlayLine" ToolTip="{DynamicResource i18n.B0D46CCB3F720F6A}" AutomationProperties.Name="{DynamicResource i18n.50EB00A580A814F2}" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}"/>
    <TextBlock Text="{DynamicResource i18n.EECCEEAA6D3E1702}" Margin="0,0,12,0"/>
    <TextBlock x:Name="PlayStatus" Text="{DynamicResource i18n.D108F0FB2375B53B}" Foreground="{DynamicResource Muted}"/>
   </WrapPanel>
  </StackPanel>
  <WrapPanel x:Name="EditActions" Grid.Row="5" Margin="0,16,0,0">
   <Button x:Name="DeleteAllLyricsButton" Content="{DynamicResource i18n.E2168BB442E957B1}" Click="DeleteAllLines" Style="{StaticResource IconLabelButton}" Tag="{StaticResource ClearIcon}"/>
   <Button Content="{DynamicResource i18n.B79948EA6BA29C88}" Click="AddLine" Style="{StaticResource IconLabelButton}" Tag="{StaticResource AddIcon}"/><Button Content="{DynamicResource i18n.9A62796CFAC4E228}" Click="DeleteLine" Style="{StaticResource IconLabelButton}" Tag="{StaticResource ClearIcon}"/><Button Content="{DynamicResource i18n.66BC62EE7160D42F}" Click="SaveDraftClick" Style="{StaticResource IconLabelButton}" Tag="{StaticResource SaveProjectIcon}"/>
   <Button Content="{DynamicResource i18n.7E99264F95748A0A}" Tag="lrc" Click="Export" Style="{StaticResource TextExportButton}"/><Button Content="{DynamicResource i18n.5B3218F7F78EBF52}" Tag="srt" Click="Export" Style="{StaticResource TextExportButton}"/>
   <Button Content="{DynamicResource i18n.8D40AFC601883E43}" Tag="txt" Click="Export" Style="{StaticResource TextExportButton}"/>
   <TextBlock Text="{DynamicResource i18n.2B9B537A44EF3928}" Foreground="{DynamicResource Muted}"/>
  </WrapPanel>
 </Grid>
</Window>
