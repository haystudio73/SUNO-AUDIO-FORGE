<Window x:Class="StemForge.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="{DynamicResource i18n.60B8F9222E6D1376}" Width="1000" Height="720" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{DynamicResource i18n.F59F2B8D280DD2EC}" FontSize="24" Margin="0,0,0,16"/>
  <TextBox x:Name="Search" Grid.Row="1" TextChanged="Filter" ToolTip="{DynamicResource i18n.605F2ED44D7B0CBA}" AutomationProperties.Name="{DynamicResource i18n.5812F6993D770936}" Margin="0,0,0,12"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="{DynamicResource i18n.02E168F04D449D0D}" Style="{StaticResource Caption}"/>
    <ListBox x:Name="SessionsList" MouseDoubleClick="OpenSelected" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdatedLocal}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding Availability}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource Muted}" ToolTip="{Binding Source}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
   <DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="{DynamicResource i18n.35CF527D1A8928B5}" Style="{StaticResource Caption}"/>
    <ListBox x:Name="EventsList" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CreatedLocal}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Output}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Output}" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="Count" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource i18n.E07E77C9A60241AE}" Click="OpenOutputFolder" Style="{StaticResource IconLabelButton}" Tag="{StaticResource OpenProjectIcon}"/><Button Content="{DynamicResource i18n.5314D1639E9138CC}" Click="OpenSelected" Style="{StaticResource IconLabelButton}" Tag="{StaticResource HistoryIcon}"/><Button Content="{DynamicResource i18n.5D54C2A1A341732E}" IsCancel="True" Margin="0" Style="{StaticResource IconLabelButton}" Tag="{StaticResource CancelIcon}"/></StackPanel></DockPanel>
 </Grid>
</Window>
