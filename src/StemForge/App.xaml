<Application x:Class="StemForge.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StemForge">
 <Application.Resources>
  <!-- Change to Visible to restore the sample-layering/replacement UI. DSP and saved data are unchanged. -->
  <Visibility x:Key="SampleToolsVisibility">Collapsed</Visibility>
  <SolidColorBrush x:Key="AppBackground" Color="#0B0C0A"/>
  <SolidColorBrush x:Key="Surface" Color="#101410"/>
  <SolidColorBrush x:Key="InputBackground" Color="#151916"/>
  <SolidColorBrush x:Key="ButtonBackground" Color="#1B201D"/>
  <SolidColorBrush x:Key="Text" Color="#E7ECE8"/>
  <SolidColorBrush x:Key="Line" Color="#394B40"/>
  <SolidColorBrush x:Key="AccentText" Color="#0B0C0A"/>

  <SolidColorBrush x:Key="Accent" Color="#00E676"/>
  <SolidColorBrush x:Key="ProcessedWave" Color="#FFB454"/>
  <SolidColorBrush x:Key="DrumWave" Color="#55CAFF"/>
  <SolidColorBrush x:Key="ProcessedDrumWave" Color="#D296FF"/>
  <SolidColorBrush x:Key="kickWave" Color="#55CAFF"/>
  <SolidColorBrush x:Key="snareWave" Color="#FF8F8F"/>
  <SolidColorBrush x:Key="tomsWave" Color="#C6A0FF"/>
  <SolidColorBrush x:Key="hatWave" Color="#FFD166"/>
  <SolidColorBrush x:Key="rideWave" Color="#76D9AF"/>
  <SolidColorBrush x:Key="crashWave" Color="#FF9BD4"/>
  <SolidColorBrush x:Key="Muted" Color="#929B96"/>
  <Style x:Key="AppWindow" TargetType="Window"><Setter Property="Icon" Value="/SunoAudioForge;component/Assets/SunoAudioForge.ico"/><Setter Property="Background" Value="{DynamicResource AppBackground}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontFamily" Value="Cascadia Mono,Consolas"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Stroke="{DynamicResource Text}" StrokeThickness="1.5" Data="M0,0 L4,4 8,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Margin="9,4,26,4" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{DynamicResource Surface}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="6" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource InputBackground}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8,14,8"/></Style>
  <Style x:Key="ListenChoice" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal">
    <Border x:Name="ChoiceBox" Width="14" Height="14" BorderBrush="{DynamicResource Muted}" BorderThickness="1" Background="{DynamicResource InputBackground}" VerticalAlignment="Center" Margin="0,0,6,0">
     <Path x:Name="Mark" Data="M2,6 L5,9 11,2" Stroke="{DynamicResource Accent}" StrokeThickness="2" Visibility="Collapsed"/>
    </Border><ContentPresenter VerticalAlignment="Center"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="ChoiceBox" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceBox" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Margin" Value="0,9,0,9"/><Setter Property="MinWidth" Value="100"/></Style>
  <Geometry x:Key="PlayIcon">M4,2 L18,10 4,18 Z</Geometry>
  <Geometry x:Key="PauseIcon">M4,2 L8,2 8,18 4,18 Z M12,2 L16,2 16,18 12,18 Z</Geometry>
  <Geometry x:Key="StopIcon">M3,3 L17,3 17,17 3,17 Z</Geometry>
  <Geometry x:Key="RepeatIcon">M4,5 L17,5 14,2 M17,5 L14,8 M16,15 L3,15 6,12 M3,15 L6,18 M2,9 L2,7 Q2,5 4,5 M18,11 L18,13 Q18,15 16,15</Geometry>
  <Geometry x:Key="HistoryIcon">M3,9 A9,9 0 1 1 4,18 M3,3 L3,9 9,9 M12,6 L12,12 16,14</Geometry>
  <Geometry x:Key="NewProjectIcon">M3,2 L14,2 21,9 21,22 3,22 Z M14,2 L14,9 21,9 M7,15 L17,15 M12,10 L12,20</Geometry>
  <Geometry x:Key="OpenProjectIcon">M2,19 L2,5 9,5 11,8 21,8 21,11 M2,19 L6,11 23,11 19,19 Z</Geometry>
  <Geometry x:Key="SaveProjectIcon">M3,3 L18,3 21,6 21,21 3,21 Z M7,3 L7,10 17,10 17,3 M7,21 L7,14 17,14 17,21 M14,5 L14,8</Geometry>
  <Geometry x:Key="AudioFolderIcon">M2,19 L2,5 9,5 11,8 22,8 22,19 Z M6,12 L6,16 M10,10 L10,18 M14,12 L14,16 M18,11 L18,17</Geometry>
  <Geometry x:Key="ExportAudioIcon">M4,13 L4,21 21,21 21,13 M12,3 L12,16 M7,11 L12,16 17,11 M2,7 L2,11 M5,5 L5,9 M19,5 L19,9 M22,7 L22,11</Geometry>
  <Geometry x:Key="ExportStemsIcon">M2,3 L10,3 M2,7 L10,7 M2,11 L10,11 M16,3 L16,15 M12,11 L16,15 20,11 M7,17 L7,21 23,21 23,17</Geometry>
  <Geometry x:Key="ExportMidiIcon">M2,3 L22,3 22,15 2,15 Z M7,3 L7,11 M12,3 L12,11 M17,3 L17,11 M12,17 L12,23 M9,20 L12,23 15,20</Geometry>
  <Geometry x:Key="ResetIcon">M4,8 A8,8 0 1 1 4,16 M4,2 L4,8 10,8</Geometry>
  <Geometry x:Key="PunchIcon">M13,2 L4,13 11,13 9,22 20,9 13,9 Z</Geometry>
  <Geometry x:Key="TightIcon">M2,6 L8,12 2,18 M22,6 L16,12 22,18 M11,3 L11,21 M13,3 L13,21</Geometry>
  <Geometry x:Key="LayerIcon">M2,7 L12,2 22,7 12,12 Z M2,12 L12,17 22,12 M2,17 L12,22 22,17</Geometry>
  <Geometry x:Key="ApplyIcon">M3,12 L9,18 21,5</Geometry>
  <Geometry x:Key="AboutIcon">M12,2 A10,10 0 1 1 11.99,2 M12,10 L12,18 M12,6 L12,7</Geometry>
  <Geometry x:Key="ClearIcon">M3,6 L21,6 M9,6 L9,3 15,3 15,6 M5,6 L6,21 18,21 19,6 M10,10 L10,17 M14,10 L14,17</Geometry>
  <Geometry x:Key="SampleIcon">M3,2 L15,2 21,8 21,22 3,22 Z M15,2 L15,8 21,8 M6,14 L8,14 10,10 12,18 14,12 16,14 18,14</Geometry>
  <Geometry x:Key="CancelIcon">M4,4 L20,20 M20,4 L4,20</Geometry>
  <Geometry x:Key="DownloadIcon">M12,2 L12,16 M6,10 L12,16 18,10 M3,17 L3,22 21,22 21,17</Geometry>
  <Geometry x:Key="LyricsIcon">M3,3 L21,3 21,21 3,21 Z M7,8 L17,8 M7,12 L17,12 M7,16 L13,16</Geometry>
  <Geometry x:Key="AddIcon">M12,3 L12,21 M3,12 L21,12</Geometry>
  <Geometry x:Key="SplitIcon">M3,12 L10,12 M10,12 L16,5 22,5 M10,12 L16,19 22,19 M19,2 L22,5 19,8 M19,16 L22,19 19,22</Geometry>
  <Style x:Key="IconLabelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="10,9"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal">
    <Path Width="17" Height="17" Margin="0,0,8,0" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
   </StackPanel></DataTemplate></Setter.Value></Setter>
  </Style>
  <!-- Sample Tag identifies the instrument for file selection; it must remain a string. -->
  <Style x:Key="SampleIconButton" TargetType="Button" BasedOn="{StaticResource IconLabelButton}">
   <Setter Property="Margin" Value="0,0,8,6"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal">
    <Path Width="17" Height="17" Margin="0,0,8,0" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round" Data="{StaticResource SampleIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
   </StackPanel></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TextExportButton" TargetType="Button" BasedOn="{StaticResource IconLabelButton}">
   <Setter Property="Margin" Value="0,0,8,6"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal">
    <Path Width="17" Height="17" Margin="0,0,8,0" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round" Data="{StaticResource ExportStemsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
   </StackPanel></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="42"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Path Width="17" Height="17" Stretch="Uniform" Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shape" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RepeatButton" TargetType="CheckBox">
   <Setter Property="Width" Value="42"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="{DynamicResource i18n.BCD3B94AE98287FA}"/><Setter Property="AutomationProperties.Name" Value="{DynamicResource i18n.BCD3B94AE98287FA}"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Shape" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Path Data="{StaticResource RepeatIcon}" Width="20" Height="20" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/><Setter Property="Background" Value="{DynamicResource Surface}"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,8"/></Style>

  <Style x:Key="StepPanel" TargetType="local:StepBox">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StepBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <StackPanel>
      <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Caption}"/>
      <ContentPresenter x:Name="StepBody" ContentSource="Content" HorizontalAlignment="Stretch"/>
      <ToggleButton x:Name="StepToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalAlignment="Right" Width="30" Height="24" Margin="0,8,0,0" ToolTip="{DynamicResource i18n.81120895B35FFD51}" AutomationProperties.Name="{DynamicResource i18n.81120895B35FFD51}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleBorder" Background="{DynamicResource ButtonBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5"><Path x:Name="Chevron" Data="M0,5 L5,0 10,5" Width="10" Height="5" Stretch="Uniform" Stroke="{DynamicResource Text}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="False"><Setter TargetName="Chevron" Property="Data" Value="M0,0 L5,5 10,0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="StepBody" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepToggle" Property="ToolTip" Value="{DynamicResource i18n.C9F1338CB922F961}"/><Setter TargetName="StepToggle" Property="AutomationProperties.Name" Value="{DynamicResource i18n.C9F1338CB922F961}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
